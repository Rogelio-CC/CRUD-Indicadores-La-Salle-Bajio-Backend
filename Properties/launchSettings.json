{
  //ESTE ARCHIVO FUNCIONA ÚNICAMENTE DE FORMA LOCAL.
  "$schema": "https://json.schemastore.org/launchsettings.json",
  // La sección "profiles" define cómo se puede ejecutar la app desde Visual Studio o CLI (Command Line Interface).
  // Cada perfil es una forma distinta de lanzar el proyecto.
  "profiles": {
    // Perfil llamado http para ejecutar la app usando Kestrel (el servidor web multiplataforma de .NET).
    "http": {
      "commandName": "Project", // Indica que se ejecutará el proyecto directamente (usualmente usa Kestrel).
      "dotnetRunMessages": true, // Muestra mensajes informativos en la consola sobre el estado del servidor y la compilación.
      "launchBrowser": false, // Abre automáticamente el navegador predeterminado al iniciar la aplicación (en esta caso, no abrirá ningú navegador).
      "applicationUrl": "http://localhost:5283", // Direcciones donde la app escuchará peticiones.
      // Define que la app corre en modo desarrollo para habilitar páginas de error detalladas.
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    // Perfil llamado https para ejecutar la app usando Kestrel (el servidor web multiplataforma de .NET)
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7295;http://localhost:5283", // Direcciones donde la app escuchará peticiones (HTTP y HTTPS).
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
